# Faraday Web — environment
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Model plane (Anthropic) -------------------------------------------------
# The only provider. Both fleet members are Anthropic models; routing between
# them is what the routing chip shows. Read only by api/turn.ts — never bundled.
ANTHROPIC_API_KEY=

# Fleet member ids.
# Vision / document lane — a message carrying an attached image routes here.
FARADAY_MODEL_VISION=claude-haiku-4-5-20251001
# Coder / calculation lane — a coding or calculation request routes here.
FARADAY_MODEL_CODER=claude-sonnet-5

# Thinking depth for the coder lane. Sonnet 5 uses adaptive thinking; a fixed
# token budget is rejected by the API. `low` is enough to be visible, not enough
# to make the demo wait. One of: low | medium | high.
FARADAY_CODER_EFFORT=low

# --- Fallback model plane (Groq, OpenAI-compatible) --------------------------
# Used only when Anthropic fails before producing anything. The transcript says
# when the fallback answered. Leave empty to disable.
GROQ_API_KEY=
FARADAY_FALLBACK_CODER=openai/gpt-oss-20b
FARADAY_FALLBACK_VISION=qwen/qwen3.8-27b
