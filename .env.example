# Faraday Web — environment
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Model plane (Groq, primary) ---------------------------------------------
# Both fleet members are open-weight models hosted on Groq; routing between
# them is what the routing chip shows. Read only by api/turn.ts — never bundled.
GROQ_API_KEY=
# Vision / document lane — a message carrying an attached image routes here.
FARADAY_MODEL_VISION=qwen/qwen3.8-27b
# Coder / calculation lane — a coding or calculation request routes here.
FARADAY_MODEL_CODER=openai/gpt-oss-20b

# --- Fallback model plane (Gemini API, Gemma 4) ------------------------------
# Used only when Groq fails before producing anything. The transcript says when
# the fallback answered. Leave empty to disable.
GEMINI_API_KEY=
FARADAY_FALLBACK_CODER=gemma-4-26b-a4b-it
FARADAY_FALLBACK_VISION=gemma-4-31b-it
